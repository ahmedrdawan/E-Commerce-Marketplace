
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce Marketplace</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/E_Commerce.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg marketplace-navbar">
            <div class="container">
                <a class="navbar-brand marketplace-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">M</span>
                    <span>MarketPlace</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Index">Shop</a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Cart" asp-action="Index">Cart</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Order" asp-action="MyOrders">My Orders</a></li>
                            }

                            @if (User.IsInRole("Seller"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Seller" asp-action="Dashboard">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Seller" asp-action="Products">My Products</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Seller" asp-action="Orders">Orders</a></li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users">Users</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="SellerRequests">Seller Requests</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Categories">Categories</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Products">Products</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Orders">Orders</a></li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="user-pill" asp-controller="Account" asp-action="Profile">
                                    <span class="user-avatar">@((User.Identity?.Name ?? "U").Substring(0, 1).ToUpper())</span>
                                    <span>@User.Identity!.Name</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-light logout-btn">Log Out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a></li>
                            <li class="nav-item"><a class="btn btn-primary nav-signup" asp-controller="Account" asp-action="Register">Create Account</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container alert-area">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success custom-alert alert-dismissible fade show" role="alert">
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger custom-alert alert-dismissible fade show" role="alert">
                <span>@TempData["Error"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <div class="container page-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="marketplace-footer">
        <div class="container">
            <div class="footer-main">
                <div>
                    <div class="footer-brand">MarketPlace</div>
                    <p>Shop products from sellers in one place.</p>
                </div>
                <div class="footer-links">
                    <a asp-controller="Product" asp-action="Index">Shop</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                    @if (!SignInManager.IsSignedIn(User))
                    {
                        <a asp-controller="Account" asp-action="Login">Sign In</a>
                    }
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year MarketPlace</span>
                <span>Graduation Project ITI</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>

    @Html.AntiForgeryToken()

    <div class="chatbot-widget">
        <button id="chatbotToggleBtn" class="chatbot-toggle-btn" aria-label="Toggle Chat">Chat</button>
        <div id="chatbotPanel" class="chatbot-panel">
            <div class="chatbot-header">
                <span>AI Shopping Assistant</span>
                <button id="chatbotCloseBtn" class="chatbot-close-btn" aria-label="Close Chat">&times;</button>
            </div>
            <div id="chatbotMessages" class="chatbot-messages">
                <div id="chatbotTypingIndicator" class="chatbot-typing-indicator">
                    <span></span><span></span><span></span>
                </div>
            </div>
            <div class="chatbot-input-area">
                <input type="text" id="chatbotInput" class="chatbot-input" placeholder="Type your message..." autocomplete="off" />
                <button id="chatbotSendBtn" class="chatbot-send-btn" aria-label="Send">Send</button>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
