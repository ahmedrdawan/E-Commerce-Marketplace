@model IReadOnlyList<ProductListItemViewModel>
@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 bg-light rounded-3 text-center">
    <h1 class="display-6">Welcome to the E-Commerce Marketplace</h1>
    <p class="lead">Shop from dozens of sellers in one place.</p>
    <a class="btn btn-primary btn-lg" asp-controller="Product" asp-action="Index">Browse Products</a>
</div>

<h3 class="mb-3">Latest Products</h3>
<div class="row row-cols-1 row-cols-md-4 g-4">
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="card h-100 product-card">
                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/no-image.svg" : p.ImageUrl)" class="card-img-top" alt="@p.Name" onerror="this.onerror=null;this.src='/images/no-image.svg'" />
                <div class="card-body">
                    <h6 class="card-title">@p.Name</h6>
                    <p class="card-text text-primary fw-bold">@p.Price.ToString("0.00") EGP</p>
                    <a class="btn btn-outline-primary btn-sm w-100" asp-controller="Product" asp-action="Details" asp-route-id="@p.Id">View Details</a>
                </div>
            </div>
        </div>
    }
</div>