
@model IReadOnlyList<ProductListItemViewModel>
@{
    ViewData["Title"] = "Home";
}

<section class="home-hero">
    <div class="home-hero-content">
        <span class="hero-eyebrow">Your online marketplace</span>
        <h1>Find what you need. Shop with ease.</h1>
        <p>Discover products from different sellers, compare prices, save your favorites, and place your order in a few steps.</p>
        <div class="hero-actions">
            <a class="btn btn-light btn-lg" asp-controller="Product" asp-action="Index">Browse Products</a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Register">Create Account</a>
            }
        </div>
    </div>
</section>

<div class="section-heading">
    <div>
        <h2 class="mb-0">Latest Products</h2>
        <p>Explore the newest products added to the marketplace.</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Product" asp-action="Index">View All</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 product-grid">
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="card product-card">
                <div class="product-image-wrap">
                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/no-image.svg" : p.ImageUrl)"
                         alt="@p.Name"
                         onerror="this.onerror=null;this.src='/images/no-image.svg'" />
                </div>
                <div class="card-body d-flex flex-column">
                    <div class="product-meta mb-1">@p.CategoryName</div>
                    <h6 class="card-title">@p.Name</h6>
                    <div class="mt-auto d-flex align-items-center justify-content-between gap-2">
                        <span class="price">@p.Price.ToString("0.00") EGP</span>
                        <a class="btn btn-sm btn-primary" asp-controller="Product" asp-action="Details" asp-route-id="@p.Id">View</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
