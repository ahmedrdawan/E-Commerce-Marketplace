@model dynamic

@{
    ViewData["Title"] = "Home Page";

    IEnumerable<E_Commerce.Entities.Category> categories = null;

    // support being passed either HomeViewModel or IEnumerable<Category>
    if (Model is IEnumerable<E_Commerce.Entities.Category>)
    {
        categories = (IEnumerable<E_Commerce.Entities.Category>)Model;
    }
    else if (Model != null)
    {
        // attempt to read Categories property (HomeViewModel)
        var prop = Model.GetType().GetProperty("Categories");
        if (prop != null)
            categories = prop.GetValue(Model) as IEnumerable<E_Commerce.Entities.Category>;
    }

    categories = categories ?? new List<E_Commerce.Entities.Category>();
}

<h1>Categories</h1>
<p>
    <a asp-controller="Categories" asp-action="Create" class="btn btn-success">Add Category</a>
</p>
<ul class="list-unstyled">
@foreach (var c in categories)
{
    <li class="card mb-3">
        <div class="card-body">
            <h4>@c.Name</h4>
            <p>@c.Description</p>
            <a asp-controller="Products" asp-action="Create" asp-route-categoryId="@c.Id" class="btn btn-sm btn-primary">Add product in this category</a>
            <a asp-controller="Categories" asp-action="Edit" asp-route-categoryId="@c.Id" class="btn btn-sm btn-primary">Edit category</a>
            <a asp-controller="Categories" asp-action="Delete" asp-route-categoryId="@c.Id" class="btn btn-sm btn-primary">Delet category</a>
            <a asp-controller="Categories" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-secondary ml-2">View Catigeries</a>

            @if (c.Products != null && c.Products.Any())
            {
                <h5 class="mt-3">Products</h5>
                <ul>
                @foreach (var p in c.Products)
                {
                    <li>@p.Name - @p.Price.ToString("C")</li>
                }
                </ul>
            }
        </div>
    </li>
}
</ul>
