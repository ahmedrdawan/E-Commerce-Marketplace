
@model EditProductViewModel
@{
    ViewData["Title"] = "Edit Product";
    var categories = (IReadOnlyList<Category>)ViewBag.Categories;
}

<h2 class="mb-4">Edit Product</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Id" type="hidden" />
    <input asp-for="ExistingImageUrl" type="hidden" />

    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select asp-for="CategoryId" class="form-select">
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-md-4">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-4">
        <label asp-for="AvailableQuantity" class="form-label"></label>
        <input asp-for="AvailableQuantity" class="form-control" type="number" />
    </div>
    <div class="col-md-4">
        <label asp-for="ImageFile" class="form-label">Change image (optional)</label>
        <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
        {
            <img src="@Model.ExistingImageUrl" width="80" class="mt-2 rounded" />
        }
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}