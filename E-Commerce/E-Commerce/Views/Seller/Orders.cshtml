
@model IReadOnlyList<OrderItem>
@{
    ViewData["Title"] = "My Product Orders";
}

<h2 class="mb-4">Orders for My Products</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No orders yet.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Product</th>
                <th>Customer</th>
                <th>Quantity</th>
                <th>Total</th>
                <th>Status</th>
                <th>Update Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>#@item.OrderId</td>
                    <td>@item.Product?.Name</td>
                    <td>@item.Order?.Customer?.FullName</td>
                    <td>@item.Quantity</td>
                    <td>@item.LineTotal.ToString("0.00")</td>
                    <td><span class="badge bg-secondary">@item.Status</span></td>
                    <td style="width:220px">
                        @if (item.Status != OrderStatus.Cancelled)
                        {
                            <form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-1">
                                <input type="hidden" name="orderItemId" value="@item.Id" />
                                <select name="status" class="form-select form-select-sm">
                                    <option value="@OrderStatus.Pending" selected="@(item.Status == OrderStatus.Pending)">Pending</option>
                                    <option value="@OrderStatus.Confirmed" selected="@(item.Status == OrderStatus.Confirmed)">Confirmed</option>
                                    <option value="@OrderStatus.Shipped" selected="@(item.Status == OrderStatus.Shipped)">Shipped</option>
                                    <option value="@OrderStatus.Delivered" selected="@(item.Status == OrderStatus.Delivered)">Delivered</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}