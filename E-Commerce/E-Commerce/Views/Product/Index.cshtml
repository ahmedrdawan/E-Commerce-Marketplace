@model IReadOnlyList<ProductListItemViewModel>
@{
    ViewData["Title"] = "Products";
    var filter = (ProductSearchFilterViewModel)ViewBag.Filter;
    var categories = (IReadOnlyList<Category>)ViewBag.Categories;
    int totalPages = ViewBag.TotalPages;
}

<h2 class="mb-4">Products</h2>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="Keyword" value="@filter.Keyword" class="form-control" placeholder="Search for a product..." />
    </div>
    <div class="col-md-3">
        <select name="CategoryId" class="form-select">
            <option value="">All Categories</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(filter.CategoryId == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="SortByPrice" class="form-select">
            <option value="">Default order</option>
            <option value="asc" selected="@(filter.SortByPrice == "asc")">Price: low to high</option>
            <option value="desc" selected="@(filter.SortByPrice == "desc")">Price: high to low</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No matching products found.</div>
}

<div class="row row-cols-1 row-cols-md-4 g-4">
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="card h-100 product-card">
                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/no-image.svg" : p.ImageUrl)" class="card-img-top" alt="@p.Name" />
                <div class="card-body d-flex flex-column">
                    <h6 class="card-title">@p.Name</h6>
                    <p class="text-muted small mb-1">@p.CategoryName - @p.SellerName</p>
                    <p class="rating-stars mb-1">@(p.ReviewCount > 0 ? $"⭐ {p.AverageRating:0.0} ({p.ReviewCount} reviews)" : "No reviews")</p>
                    <p class="card-text text-primary fw-bold">@p.Price.ToString("0.00") EGP</p>
                    <a class="btn btn-outline-primary btn-sm mt-auto" asp-controller="Product" asp-action="Details" asp-route-id="@p.Id">View Details</a>
                </div>
            </div>
        </div>
    }
</div>

@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == filter.Page ? "active" : "")">
                    <a class="page-link" asp-route-Page="@i" asp-route-Keyword="@filter.Keyword" asp-route-CategoryId="@filter.CategoryId" asp-route-SortByPrice="@filter.SortByPrice">@i</a>
                </li>
            }
        </ul>
    </nav>
}