
@model IReadOnlyList<ProductListItemViewModel>
@{
    ViewData["Title"] = "Products";
    var filter = (ProductSearchFilterViewModel)ViewBag.Filter;
    var categories = (IReadOnlyList<Category>)ViewBag.Categories;
    int totalPages = ViewBag.TotalPages;
}

<div class="shop-header">
    <h1>Shop Products</h1>
    <p>Search, filter, and compare products from marketplace sellers.</p>
</div>

<div class="card filter-card">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-lg-4">
            <label class="form-label">Search</label>
            <input type="text" name="Keyword" value="@filter.Keyword" class="form-control" placeholder="Search for a product..." />
        </div>
        <div class="col-lg-3">
            <label class="form-label">Category</label>
            <select name="CategoryId" class="form-select">
                <option value="">All Categories</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id" selected="@(filter.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-lg-3">
            <label class="form-label">Sort by price</label>
            <select name="SortByPrice" class="form-select">
                <option value="">Default order</option>
                <option value="asc" selected="@(filter.SortByPrice == "asc")">Low to high</option>
                <option value="desc" selected="@(filter.SortByPrice == "desc")">High to low</option>
            </select>
        </div>
        <div class="col-lg-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h4>No products found</h4>
        <p class="mb-0">Try another keyword or category.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 product-grid">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card product-card">
                    <div class="product-image-wrap">
                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/no-image.svg" : p.ImageUrl)"
                             alt="@p.Name"
                             onerror="this.onerror=null;this.src='/images/no-image.svg'" />
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="product-meta">@p.CategoryName</div>
                        <h6 class="card-title">@p.Name</h6>
                        <p class="product-meta mb-2">Sold by @p.SellerName</p>
                        <p class="rating-stars mb-2">
                            @(p.ReviewCount > 0 ? $"★ {p.AverageRating:0.0} ({p.ReviewCount})" : "No reviews")
                        </p>
                        <div class="mt-auto d-flex justify-content-between align-items-center gap-2">
                            <span class="price">@p.Price.ToString("0.00") EGP</span>
                            <a class="btn btn-sm btn-primary" asp-controller="Product" asp-action="Details" asp-route-id="@p.Id">View</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (totalPages > 1)
{
    <nav class="mt-5" aria-label="Products pages">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == filter.Page ? "active" : "")">
                    <a class="page-link" asp-route-Page="@i" asp-route-Keyword="@filter.Keyword" asp-route-CategoryId="@filter.CategoryId" asp-route-SortByPrice="@filter.SortByPrice">@i</a>
                </li>
            }
        </ul>
    </nav>
}
