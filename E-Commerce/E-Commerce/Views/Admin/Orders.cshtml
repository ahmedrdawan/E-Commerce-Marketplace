
@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "All Orders";
}

<h2 class="mb-4">All Orders</h2>

@if (!Model.Any())
{
    <p class="text-muted">No orders yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Item Count</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>#@o.Id</td>
                    <td>@o.Customer?.FullName</td>
                    <td>@o.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@o.OrderItems.Count</td>
                    <td>@o.TotalPrice.ToString("0.00")</td>
                    <td><span class="badge bg-info text-dark">@o.Status</span></td>
                    <td><a class="btn btn-sm btn-outline-primary" asp-action="OrderDetails" asp-route-id="@o.Id">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
}