@model IEnumerable<E_Commerce.Entities.SellerRequest>

@{
    ViewData["Title"] = "Seller Requests";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <div class="mb-4">

                        <h2 class="mb-1">
                            Seller Requests
                        </h2>

                        <p class="text-muted mb-0">
                            Review and manage seller requests.
                        </p>

                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">

                            <h5>
                                No Pending Requests
                            </h5>

                            <p class="text-muted">
                                There are currently no pending seller requests.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle">

                                <thead class="table-light">

                                    <tr>
                                        <th>User</th>
                                        <th>Email</th>
                                        <th>Requested At</th>
                                        <th class="text-center">Actions</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var request in Model)
                                    {
                                        <tr>

                                            <td>
                                                @request.User?.FullName
                                            </td>

                                            <td>
                                                @request.User?.Email
                                            </td>

                                            <td>
                                                @request.RequestedAt.ToLocalTime()
                                            </td>

                                            <td class="text-center">

                                                <form asp-action="Approve"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@request.Id" />

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm me-1">
                                                        Approve
                                                    </button>

                                                </form>

                                                <form asp-action="Reject"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@request.Id" />

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm">
                                                        Reject
                                                    </button>

                                                </form>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>