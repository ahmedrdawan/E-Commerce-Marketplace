@model IEnumerable<E_Commerce.Entities.SellerRequest>

@{
    ViewData["Title"] = "My Seller Requests";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div>
                            <h2 class="mb-1">
                                My Seller Requests
                            </h2>

                            <p class="text-muted mb-0">
                                View the status of your seller requests.
                            </p>
                        </div>

                        <a asp-action="Create"
                               class="btn btn-primary">
                            Request Seller
                        </a>

                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">

                            <h5>
                                No Seller Requests
                            </h5>

                            <p class="text-muted">
                                You have not submitted a seller request yet.
                            </p>

                            <a asp-action="Create"
                                   class="btn btn-primary">
                                Request Seller
                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle">

                                <thead class="table-light">

                                    <tr>
                                        <th>Requested At</th>
                                        <th>Status</th>
                                        <th>Reviewed At</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var request in Model)
                                    {
                                        <tr>

                                            <td>
                                                @request.RequestedAt.ToLocalTime()
                                            </td>

                                            <td>

                                                @if (request.Status.ToString() == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Pending
                                                    </span>
                                                }
                                                else if (request.Status.ToString() == "Approved")
                                                {
                                                    <span class="badge bg-success">
                                                        Approved
                                                    </span>
                                                }
                                                else if (request.Status.ToString() == "Rejected")
                                                {
                                                    <span class="badge bg-danger">
                                                        Rejected
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        @request.Status
                                                    </span>
                                                }

                                            </td>

                                            <td>
                                                @if (request.ReviewedAt.HasValue)
                                                {
                                                    @request.ReviewedAt.Value.ToLocalTime()
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Not reviewed yet
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>