@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Wishlist";
}

<h2 class="mb-4">Wishlist</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Your wishlist is empty.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 product-card">
                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/no-image.svg" : p.ImageUrl)" class="card-img-top" />
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title">@p.Name</h6>
                        <p class="text-primary fw-bold">@p.Price.ToString("0.00") EGP</p>
                        <a class="btn btn-outline-primary btn-sm mb-2" asp-controller="Product" asp-action="Details" asp-route-id="@p.Id">Details</a>
                        <form asp-controller="Wishlist" asp-action="Remove" method="post" class="mt-auto">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Remove</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}