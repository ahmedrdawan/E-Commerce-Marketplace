@model ViewCartViewModel
@{
    ViewData["Title"] = "Cart";
}

<h2 class="mb-4">Shopping Cart</h2>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">Your cart is empty. <a asp-controller="Product" asp-action="Index">Browse Products</a></div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.svg" : item.ImageUrl)" width="50" class="me-2" />
                        @item.ProductName
                    </td>
                    <td>@item.UnitPrice.ToString("0.00")</td>
                    <td style="width:160px">
                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex gap-1">
                            <input type="hidden" name="cartItemId" value="@item.Id" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.AvailableQuantity" class="form-control form-control-sm" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                        </form>
                    </td>
                    <td>@item.LineTotal.ToString("0.00")</td>
                    <td>
                        <form asp-controller="Cart" asp-action="Remove" method="post">
                            <input type="hidden" name="cartItemId" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <h4>Total: @Model.Total.ToString("0.00") EGP</h4>
        <a class="btn btn-success btn-lg" asp-controller="Order" asp-action="Checkout">Proceed to Checkout</a>
    </div>
}