
@model CheckoutViewModel
@{
    ViewData["Title"] = "Proceed to Checkout";
    var cart = (ViewCartViewModel)ViewBag.Cart;
}

<h2 class="mb-4">Proceed to Checkout</h2>

<div class="row">
    <div class="col-md-7">
        <form asp-action="Checkout" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="ShippingAddress" class="form-label">Shipping Address</label>
                <textarea asp-for="ShippingAddress" class="form-control" rows="3"></textarea>
                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-success btn-lg">Confirm Order</button>
        </form>
    </div>
    <div class="col-md-5">
        <h5>Order Summary</h5>
        <ul class="list-group">
            @foreach (var item in cart.Items)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@item.ProductName × @item.Quantity</span>
                    <span>@item.LineTotal.ToString("0.00")</span>
                </li>
            }
            <li class="list-group-item d-flex justify-content-between fw-bold">
                <span>Total</span>
                <span>@cart.Total.ToString("0.00") EGP</span>
            </li>
        </ul>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}