@model E_Commerce.Entities.Product

@{
    ViewData["Title"] = "Details";
}

<h1>Product Details</h1>

<div>
    <h2>@Model.Name</h2>
    <p>@Model.Description</p>
    <p>Price: @Model.Price.ToString("C")</p>
    <p>Available: @Model.AvailableQuantity</p>
    <p>Category: @Model.Category?.Name</p>
</div>
