@model IEnumerable<E_Commerce.Entities.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>All Products</h1>

<form method="get" asp-action="Search">
    <div class="form-inline mb-3">
        <input type="text" name="query" class="form-control mr-2" placeholder="Search products..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Category</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Name</td>
            <td>@p.Price.ToString("C")</td>
            <td>@p.Category?.Name</td>
            <td>
                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
